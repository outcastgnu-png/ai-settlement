+++ b/src/local-config.ts
@@ -0,0 +1,39 @@
+// Settings for the Phase 2 local services. Everything binds to 127.0.0.1;
+// exposing a service beyond this machine needs a new EDR.
+import { randomBytes } from "node:crypto";
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { parse } from "dotenv";
+
+export const LOCALHOST = "127.0.0.1";
+
+const env = (name: string, fallback: string) => process.env[name] ?? fallback;
+
+export const ENV_FILE = env("ENV_FILE", ".env");
+export const DATA_DIR = env("DATA_DIR", "data");
+export const REGISTRY_PORT = Number(env("REGISTRY_PORT", "8801"));
+export const ORACLE_PORT = Number(env("ORACLE_PORT", "8802"));
+export const REGISTRY_URL = env("REGISTRY_URL", `http://${LOCALHOST}:${REGISTRY_PORT}`);
+export const ORACLE_URL = env("ORACLE_URL", `http://${LOCALHOST}:${ORACLE_PORT}`);
+export const JOBS_DB = env("JOBS_DB", resolve(DATA_DIR, "jobs.db"));
+export const VAULT_FILE = env("VAULT_FILE", resolve(DATA_DIR, "oracle-vault.json"));
+export const VERDICT_LOG = env("VERDICT_LOG", resolve("src", "oracle", "verdicts.jsonl"));
+
+/** Values from .env, with process.env taking precedence. */
+export function readEnvFile(path = ENV_FILE): Record<string, string> {
+  const fromFile = existsSync(path) ? parse(readFileSync(path)) : {};
+  const merged: Record<string, string> = { ...fromFile };
+  for (const key of Object.keys(fromFile)) {
+    const value = process.env[key];
+    if (value !== undefined) merged[key] = value;
+  }
+  return merged;
+}
+
+/** Add ORACLE_VAULT_KEY (32 random bytes, hex) to .env if it is missing. Never prints it. */
+export function ensureVaultKey(path = ENV_FILE): void {
+  const current = existsSync(path) ? readFileSync(path, "utf8") : "";
+  if (/^ORACLE_VAULT_KEY=/m.test(current) || process.env.ORACLE_VAULT_KEY) return;
+  const sep = current === "" || current.endsWith("\n") ? "" : "\n";
+  writeFileSync(path, `${current}${sep}ORACLE_VAULT_KEY=${randomBytes(32).toString("hex")}\n`, { mode: 0o600 });
+}
diff --git a/src/oracle/checks/index.ts b/src/oracle/checks/index.ts
new file mode 100644
index 0000000..8f35dc2
--- /dev/null
+++ b/src/oracle/checks/index.ts
@@ -0,0 +1,22 @@
+import type { CheckSpec } from "../../registry/db.js";
+import { jsonSchema } from "./json-schema.js";
+import { maxLatency } from "./max-latency.js";
+import { sha256Match } from "./sha256-match.js";
+import type { CheckContext, CheckResult } from "./types.js";
+
+export type { CheckContext, CheckResult } from "./types.js";
+
+export function runCheck(spec: CheckSpec, ctx: CheckContext): CheckResult {
+  switch (spec.type) {
+    case "sha256-match": return sha256Match(spec, ctx);
+    case "json-schema": return jsonSchema(spec, ctx);
+    case "max-latency": return maxLatency(spec, ctx);
+    default: return { type: (spec as { type: CheckSpec["type"] }).type, pass: false, detail: "unknown check type" };
+  }
+}
+
+/** Every check must pass, and there must be at least one. */
+export function runChecks(specs: CheckSpec[], ctx: CheckContext): { pass: boolean; results: CheckResult[] } {
+  const results = specs.map((s) => runCheck(s, ctx));
+  return { pass: results.length > 0 && results.every((r) => r.pass), results };
+}
diff --git a/src/oracle/checks/json-schema.ts b/src/oracle/checks/json-schema.ts
new file mode 100644
index 0000000..99245d8
--- /dev/null
+++ b/src/oracle/checks/json-schema.ts
@@ -0,0 +1,36 @@
+// Passes when the deliverable parses as JSON and validates against the job's
+// JSON Schema. JSON.parse only builds plain data; nothing in it is run.
+import { Ajv, type ValidateFunction } from "ajv";
+import type { CheckContext, CheckResult } from "./types.js";
+
+const ajv = new Ajv({ strict: true, allErrors: false });
+const compiled = new Map<string, ValidateFunction>();
+
+function validator(schema: Record<string, unknown>): ValidateFunction {
+  const key = JSON.stringify(schema);
+  let validate = compiled.get(key);
+  if (!validate) {
+    validate = ajv.compile(schema);
+    compiled.set(key, validate);
+  }
+  return validate;
+}
+
+export function jsonSchema(spec: { schema: Record<string, unknown> }, ctx: CheckContext): CheckResult {
+  const fail = (detail: string): CheckResult => ({ type: "json-schema", pass: false, detail });
+  let data: unknown;
+  try {
+    data = JSON.parse(ctx.content);
+  } catch {
+    return fail("deliverable is not valid JSON");
+  }
+  let validate: ValidateFunction;
+  try {
+    validate = validator(spec.schema);
+  } catch (err) {
+    return fail(`job schema is invalid: ${err instanceof Error ? err.message : String(err)}`);
+  }
+  if (validate(data)) return { type: "json-schema", pass: true, detail: "deliverable matches the schema" };
+  const e = validate.errors?.[0];
+  return fail(`schema violation at ${e?.instancePath || "/"}: ${e?.message ?? "invalid"}`);
+}
diff --git a/src/oracle/checks/max-latency.ts b/src/oracle/checks/max-latency.ts
new file mode 100644
index 0000000..ba0ecf1
--- /dev/null
+++ b/src/oracle/checks/max-latency.ts
@@ -0,0 +1,11 @@
+// Passes when the work was delivered within maxMs of the escrow being funded,
+// using the registry's own timestamps.
+import type { CheckContext, CheckResult } from "./types.js";
+
+export function maxLatency(spec: { maxMs: number }, ctx: CheckContext): CheckResult {
+  const fundedAt = ctx.job.fundedAt;
+  if (fundedAt === null) return { type: "max-latency", pass: false, detail: "job was never funded" };
+  const latency = ctx.deliveredAt - fundedAt;
+  const pass = latency <= spec.maxMs;
+  return { type: "max-latency", pass, detail: `delivered ${latency} ms after funding (limit ${spec.maxMs} ms)` };
+}
diff --git a/src/oracle/checks/sha256-match.ts b/src/oracle/checks/sha256-match.ts
new file mode 100644
index 0000000..c6db0d5
--- /dev/null
+++ b/src/oracle/checks/sha256-match.ts
@@ -0,0 +1,9 @@
+// Passes when the deliverable's SHA-256 equals the hash agreed in the job spec.
+import { sha256Hex } from "../../auth.js";
+import type { CheckContext, CheckResult } from "./types.js";
+
+export function sha256Match(spec: { sha256: string }, ctx: CheckContext): CheckResult {
+  const actual = sha256Hex(ctx.content);
+  const pass = actual === spec.sha256.toLowerCase();
+  return { type: "sha256-match", pass, detail: pass ? "sha256 matches the spec" : `sha256 ${actual} does not match the spec` };
+}
