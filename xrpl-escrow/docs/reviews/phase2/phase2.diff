+// A check reads the deliverable as bytes or parsed data and returns a result.
+// Checks are deterministic and never execute or follow anything inside the
+// deliverable or the job spec.
+import type { CheckSpec, Job } from "../../registry/db.js";
+
+export interface CheckContext {
+  job: Job;
+  content: string; // the deliverable exactly as the registry stored it
+  deliveredAt: number; // unix ms
+}
+
+export interface CheckResult {
+  type: CheckSpec["type"];
+  pass: boolean;
+  detail: string;
+}
diff --git a/src/oracle/server.ts b/src/oracle/server.ts
new file mode 100644
index 0000000..f6491cc
--- /dev/null
+++ b/src/oracle/server.ts
@@ -0,0 +1,141 @@
+// Verification oracle HTTP service on 127.0.0.1:8802.
+//
+//   GET  /health                   oracle address and public key, for checking verdict signatures
+//   POST /jobs/:jobId/condition    make the job's secret, seal it in the vault, set the condition in the registry
+//   POST /verify/:jobId            {auth} signed by the job's provider; runs the job's checks
+//
+// The oracle is the only process that holds secrets. It reads the job spec and
+// deliverable from the registry and only hashes, parses or validates them; it
+// never executes or follows anything inside them. A verify call returns a
+// verdict signed with the oracle wallet's key, and the fulfillment only on a
+// pass and only to the job's provider. Every verdict is appended to a JSONL log.
+import { appendFileSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import { pathToFileURL } from "node:url";
+import { Wallet } from "xrpl";
+import { checkRequest, sha256Hex, signPayload } from "../auth.js";
+import { makeSecret, toCondition, toFulfillment } from "../condition.js";
+import { HttpError, callJson, jsonServer, listenLocal, type Route } from "../http.js";
+import { ORACLE_PORT, REGISTRY_URL, VAULT_FILE, VERDICT_LOG, readEnvFile } from "../local-config.js";
+import type { Deliverable, Job } from "../registry/db.js";
+import { runChecks, type CheckResult } from "./checks/index.js";
+import { SecretVault, parseVaultKey } from "./vault.js";
+
+export interface VerdictBody {
+  jobId: string;
+  verdict: "pass" | "fail";
+  checks: CheckResult[];
+  evidenceHash: string; // sha256 of the deliverable the checks ran on
+  condition: string;
+  provider: string;
+  oracle: string; // oracle XRPL address
+  publicKey: string;
+  issuedAt: number;
+}
+
+export interface SignedVerdict extends VerdictBody {
+  signature: string;
+}
+
+export interface OracleOptions {
+  wallet: Wallet;
+  vault: SecretVault;
+  registryUrl?: string;
+  verdictLog?: string;
+}
+
+export function oracleRoutes(opts: OracleOptions): Route[] {
+  const registry = opts.registryUrl ?? REGISTRY_URL;
+  const verdictLog = opts.verdictLog ?? VERDICT_LOG;
+  const usedAuth = new Set<string>();
+  const getJob = async (id: string) => {
+    try {
+      return await callJson<Job>("GET", `${registry}/jobs/${encodeURIComponent(id)}`);
+    } catch (err) {
+      if (err instanceof HttpError && err.status === 404) throw new HttpError(404, `unknown job ${id}`);
+      throw err;
+    }
+  };
+
+  return [
+    {
+      method: "GET", path: "/health",
+      handler: () => ({ ok: true, service: "oracle", oracle: opts.wallet.address, publicKey: opts.wallet.publicKey }),
+    },
+
+    {
+      method: "POST", path: "/jobs/:jobId/condition",
+      handler: async ({ jobId }) => {
+        const job = await getJob(jobId);
+        let secret = opts.vault.get(jobId);
+        if (!secret) {
+          if (job.status !== "draft" || job.condition) throw new HttpError(409, "job already has a condition from elsewhere");
+          secret = makeSecret();
+          opts.vault.put(jobId, secret);
+        }
+        const condition = toCondition(secret);
+        await callJson("PUT", `${registry}/jobs/${encodeURIComponent(jobId)}/condition`, { condition });
+        return { jobId, condition };
+      },
+    },
+
+    {
+      method: "POST", path: "/verify/:jobId",
+      handler: async ({ jobId }, body) => {
+        const job = await getJob(jobId);
+        checkRequest((body as { auth?: unknown } | undefined)?.auth, "verify", jobId, "", job.provider, usedAuth);
+        if (!["delivered", "verified_pass", "verified_fail"].includes(job.status)) {
+          throw new HttpError(409, `job is ${job.status}; nothing to verify`);
+        }
+        const secret = opts.vault.get(jobId);
+        if (!secret || !job.condition || toCondition(secret) !== job.condition) {
+          throw new HttpError(409, "this oracle does not hold the secret for the job's condition");
+        }
+        const deliverable = await callJson<Deliverable>("GET", `${registry}/jobs/${encodeURIComponent(jobId)}/deliverable`);
+
+        const { pass, results } = runChecks(job.spec.checks, { job, content: deliverable.content, deliveredAt: deliverable.deliveredAt });
+        const unsigned: VerdictBody = {
+          jobId, verdict: pass ? "pass" : "fail", checks: results, evidenceHash: sha256Hex(deliverable.content),
+          condition: job.condition, provider: job.provider, oracle: opts.wallet.address, publicKey: opts.wallet.publicKey,
+          issuedAt: Date.now(),
+        };
+        const verdict: SignedVerdict = { ...unsigned, signature: signPayload(unsigned, opts.wallet) };
+
+        mkdirSync(dirname(verdictLog), { recursive: true });
+        appendFileSync(verdictLog, `${JSON.stringify(verdict)}\n`);
+        if (job.status === "delivered") {
+          await callJson("POST", `${registry}/jobs/${encodeURIComponent(jobId)}/events`, {
+            source: "oracle", status: pass ? "verified_pass" : "verified_fail",
+            detail: results.map((r) => `${r.type}: ${r.pass ? "pass" : "fail"}`).join(", "),
+          });
+        }
+        return pass ? { verdict, fulfillment: toFulfillment(secret) } : { verdict };
+      },
+    },
+  ];
+}
+
+export async function startOracle(opts: Partial<OracleOptions> & { port?: number } = {}) {
+  const env = readEnvFile();
+  const wallet = opts.wallet ?? (env.ORACLE_SEED ? Wallet.fromSeed(env.ORACLE_SEED) : null);
+  if (!wallet) throw new Error("ORACLE_SEED is missing from .env; run the demo once to create testnet wallets");
+  const vault = opts.vault ?? new SecretVault(VAULT_FILE, parseVaultKey(env.ORACLE_VAULT_KEY));
+  const server = jsonServer(oracleRoutes({ ...opts, wallet, vault }));
+  const port = await listenLocal(server, opts.port ?? ORACLE_PORT);
+  return {
+    port,
+    url: `http://127.0.0.1:${port}`,
+    address: wallet.address,
+    close: () => new Promise<void>((done) => {
+      server.close(() => done());
+      server.closeAllConnections();
+    }),
+  };
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  startOracle().then(({ url, address }) => console.log(`oracle ${address} listening on ${url}`), (err) => {
+    console.error(err instanceof Error ? err.message : err);
+    process.exitCode = 1;
+  });
+}
diff --git a/src/oracle/vault.ts b/src/oracle/vault.ts
new file mode 100644
index 0000000..9b2b9b1
--- /dev/null
+++ b/src/oracle/vault.ts
@@ -0,0 +1,67 @@
+// Encrypted storage for job secrets. Each secret is sealed with AES-256-GCM
+// under ORACLE_VAULT_KEY (32 bytes, hex, from .env), with the job id as
+// associated data so a sealed secret can't be moved to another job. The file
+// survives oracle restarts; the key never touches disk outside .env.
+import { createCipheriv, createDecipheriv, randomBytes } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+
+interface Sealed {
+  iv: string;
+  tag: string;
+  ct: string;
+}
+
+interface VaultFile {
+  version: 1;
+  entries: Record<string, Sealed>;
+}
+
+export function parseVaultKey(hex: string | undefined): Buffer {
+  if (!hex || !/^[0-9a-fA-F]{64}$/.test(hex)) throw new Error("ORACLE_VAULT_KEY must be 32 bytes of hex (64 characters)");
+  return Buffer.from(hex, "hex");
+}
+
+export class SecretVault {
+  readonly #key: Buffer;
+
+  constructor(readonly path: string, key: Buffer) {
+    if (key.length !== 32) throw new Error("vault key must be 32 bytes");
+    this.#key = key;
+  }
+
+  #read(): VaultFile {
+    if (!existsSync(this.path)) return { version: 1, entries: {} };
+    const file = JSON.parse(readFileSync(this.path, "utf8")) as VaultFile;
+    return { version: 1, entries: { ...file.entries } };
+  }
+
+  has(jobId: string): boolean {
+    return Object.hasOwn(this.#read().entries, jobId);
+  }
+
+  put(jobId: string, secret: Buffer): void {
+    const file = this.#read();
+    if (Object.hasOwn(file.entries, jobId)) throw new Error(`vault already holds a secret for job ${jobId}`);
+    const iv = randomBytes(12);
+    const cipher = createCipheriv("aes-256-gcm", this.#key, iv);
+    cipher.setAAD(Buffer.from(jobId, "utf8"));
+    const ct = Buffer.concat([cipher.update(secret), cipher.final()]);
+    file.entries[jobId] = { iv: iv.toString("hex"), tag: cipher.getAuthTag().toString("hex"), ct: ct.toString("hex") };
+    mkdirSync(dirname(this.path), { recursive: true });
+    const tmp = `${this.path}.tmp`;
+    writeFileSync(tmp, JSON.stringify(file, null, 1), { mode: 0o600 });
+    renameSync(tmp, this.path);
+  }
+
+  /** The job's secret, or null if the vault has none. Throws if the entry fails authentication. */
+  get(jobId: string): Buffer | null {
+    const file = this.#read();
+    if (!Object.hasOwn(file.entries, jobId)) return null;
+    const sealed = file.entries[jobId];
+    const decipher = createDecipheriv("aes-256-gcm", this.#key, Buffer.from(sealed.iv, "hex"));
+    decipher.setAAD(Buffer.from(jobId, "utf8"));
+    decipher.setAuthTag(Buffer.from(sealed.tag, "hex"));
+    return Buffer.concat([decipher.update(Buffer.from(sealed.ct, "hex")), decipher.final()]);
+  }
+}
diff --git a/src/registry/db.ts b/src/registry/db.ts
new file mode 100644
index 0000000..8a1558e
--- /dev/null
+++ b/src/registry/db.ts
@@ -0,0 +1,237 @@
+// Job registry storage in SQLite (data/jobs.db). It records the job spec,
+// price, parties, condition, escrow sequence, status and timestamps. It never
+// stores the secret or the fulfillment.
+import { randomUUID } from "node:crypto";
+import { mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import Database from "better-sqlite3";
+
+export type JobStatus =
+  | "draft" | "funded" | "delivered" | "verified_pass" | "verified_fail"
+  | "paid" | "refunded" | "expired_unclaimed";
+
+export const TERMINAL: JobStatus[] = ["paid", "refunded"];
+
+export type CheckSpec =
+  | { type: "sha256-match"; sha256: string }
+  | { type: "json-schema"; schema: Record<string, unknown> }
+  | { type: "max-latency"; maxMs: number };
+
+export interface JobSpec {
+  title?: string;
+  checks: CheckSpec[];
+}
+
+export interface Job {
+  id: string;
+  client: string;
+  provider: string;
+  priceDrops: string;
+  slaSeconds: number;
+  spec: JobSpec;
+  condition: string | null;
+  offerSequence: number | null;
+  cancelAfter: number | null; // Ripple epoch seconds
+  status: JobStatus;
+  verdict: "pass" | "fail" | null;
+  expiringSoon: boolean;
+  createTx: string | null;
+  finishTx: string | null;
+  cancelTx: string | null;
+  createdAt: number; // unix ms, for every *At field
+  fundedAt: number | null;
+  deliveredAt: number | null;
+  verifiedAt: number | null;
+  closedAt: number | null;
+  updatedAt: number;
+}
+
+export interface Deliverable {
+  jobId: string;
+  content: string;
+  sha256: string;
+  deliveredAt: number;
+}
+
+export interface JobEvent {
+  jobId: string;
+  at: number;
+  source: "ledger" | "oracle" | "registry";
+  status: JobStatus | null;
+  detail: string;
+}
+
+export interface NewJob {
+  client: string;
+  provider: string;
+  priceDrops: string;
+  slaSeconds: number;
+  spec: JobSpec;
+}
+
+/** Which status a non-ledger source may move a job to, from which status. */
+const NEXT: Record<JobStatus, JobStatus[]> = {
+  draft: ["funded"],
+  funded: ["delivered", "refunded"],
+  delivered: ["verified_pass", "verified_fail", "refunded"],
+  verified_pass: ["paid", "expired_unclaimed", "refunded"],
+  verified_fail: ["refunded"],
+  expired_unclaimed: ["refunded"],
+  paid: [],
+  refunded: [],
+};
+
+export function canMove(from: JobStatus, to: JobStatus): boolean {
+  return NEXT[from].includes(to);
+}
+
+const COLUMNS = `
+  id TEXT PRIMARY KEY, client TEXT NOT NULL, provider TEXT NOT NULL, price_drops TEXT NOT NULL,
+  sla_seconds INTEGER NOT NULL, spec TEXT NOT NULL, condition TEXT, offer_sequence INTEGER,
+  cancel_after INTEGER, status TEXT NOT NULL, verdict TEXT, expiring_soon INTEGER NOT NULL DEFAULT 0,
+  create_tx TEXT, finish_tx TEXT, cancel_tx TEXT, created_at INTEGER NOT NULL, funded_at INTEGER,
+  delivered_at INTEGER, verified_at INTEGER, closed_at INTEGER, updated_at INTEGER NOT NULL`;
+
+type Row = Record<string, unknown>;
+
+function toJob(r: Row): Job {
+  return {
+    id: r.id as string,
+    client: r.client as string,
+    provider: r.provider as string,
+    priceDrops: r.price_drops as string,
+    slaSeconds: r.sla_seconds as number,
+    spec: JSON.parse(r.spec as string),
+    condition: (r.condition as string) ?? null,
+    offerSequence: (r.offer_sequence as number) ?? null,
+    cancelAfter: (r.cancel_after as number) ?? null,
+    status: r.status as JobStatus,
+    verdict: (r.verdict as Job["verdict"]) ?? null,
+    expiringSoon: r.expiring_soon === 1,
+    createTx: (r.create_tx as string) ?? null,
+    finishTx: (r.finish_tx as string) ?? null,
+    cancelTx: (r.cancel_tx as string) ?? null,
+    createdAt: r.created_at as number,
+    fundedAt: (r.funded_at as number) ?? null,
+    deliveredAt: (r.delivered_at as number) ?? null,
+    verifiedAt: (r.verified_at as number) ?? null,
+    closedAt: (r.closed_at as number) ?? null,
+    updatedAt: r.updated_at as number,
+  };
+}
+
+const FIELD_TO_COLUMN: Record<string, string> = {
+  condition: "condition", offerSequence: "offer_sequence", cancelAfter: "cancel_after", status: "status",
+  verdict: "verdict", expiringSoon: "expiring_soon", createTx: "create_tx", finishTx: "finish_tx",
+  cancelTx: "cancel_tx", fundedAt: "funded_at", deliveredAt: "delivered_at", verifiedAt: "verified_at",
+  closedAt: "closed_at",
+};
+
+export type JobPatch = Partial<Pick<Job,
+  "condition" | "offerSequence" | "cancelAfter" | "status" | "verdict" | "expiringSoon" | "createTx" | "finishTx"
+  | "cancelTx" | "fundedAt" | "deliveredAt" | "verifiedAt" | "closedAt">>;
+
+export class JobStore {
+  readonly db: Database.Database;
+
+  constructor(path: string) {
+    if (path !== ":memory:") mkdirSync(dirname(path), { recursive: true });
+    this.db = new Database(path);
+    this.db.pragma("journal_mode = WAL");
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS jobs (${COLUMNS});
+      CREATE TABLE IF NOT EXISTS deliverables (
+        job_id TEXT PRIMARY KEY REFERENCES jobs(id), content TEXT NOT NULL, sha256 TEXT NOT NULL,
+        delivered_at INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS events (
+        job_id TEXT NOT NULL REFERENCES jobs(id), at INTEGER NOT NULL, source TEXT NOT NULL,
+        status TEXT, detail TEXT NOT NULL);
+    `);
+  }
+
+  close() {
+    this.db.close();
+  }
+
+  create(input: NewJob): Job {
+    const now = Date.now();
+    const id = randomUUID();
+    this.db.prepare(`INSERT INTO jobs (id, client, provider, price_drops, sla_seconds, spec, status, created_at, updated_at)
+      VALUES (?, ?, ?, ?, ?, ?, 'draft', ?, ?)`)
+      .run(id, input.client, input.provider, input.priceDrops, input.slaSeconds, JSON.stringify(input.spec), now, now);
+    this.addEvent({ jobId: id, at: now, source: "registry", status: "draft", detail: "job created" });
+    return this.get(id)!;
+  }
+
+  get(id: string): Job | null {
+    const row = this.db.prepare("SELECT * FROM jobs WHERE id = ?").get(id) as Row | undefined;
+    return row ? toJob(row) : null;
+  }
+
+  list(filter: { status?: string; provider?: string; client?: string } = {}): Job[] {
+    const where: string[] = [];
+    const args: string[] = [];
+    for (const [key, column] of [["status", "status"], ["provider", "provider"], ["client", "client"]] as const) {
+      if (filter[key]) {
+        where.push(`${column} = ?`);
+        args.push(filter[key]!);
+      }
+    }
+    const sql = `SELECT * FROM jobs ${where.length ? `WHERE ${where.join(" AND ")}` : ""} ORDER BY created_at`;
+    return (this.db.prepare(sql).all(...args) as Row[]).map(toJob);
+  }
+
+  update(id: string, patch: JobPatch): Job {
+    const sets: string[] = [];
+    const args: unknown[] = [];
+    for (const [field, value] of Object.entries(patch)) {
+      const column = FIELD_TO_COLUMN[field];
+      if (!column || value === undefined) continue;
+      sets.push(`${column} = ?`);
+      args.push(typeof value === "boolean" ? (value ? 1 : 0) : value);
+    }
+    sets.push("updated_at = ?");
+    args.push(Date.now(), id);
+    this.db.prepare(`UPDATE jobs SET ${sets.join(", ")} WHERE id = ?`).run(...args);
+    return this.get(id)!;
+  }
+
+  putDeliverable(d: Deliverable) {
+    this.db.prepare("INSERT INTO deliverables (job_id, content, sha256, delivered_at) VALUES (?, ?, ?, ?)")
+      .run(d.jobId, d.content, d.sha256, d.deliveredAt);
+  }
+
+  getDeliverable(jobId: string): Deliverable | null {
+    const r = this.db.prepare("SELECT * FROM deliverables WHERE job_id = ?").get(jobId) as Row | undefined;
+    return r ? { jobId, content: r.content as string, sha256: r.sha256 as string, deliveredAt: r.delivered_at as number } : null;
+  }
+
+  addEvent(e: JobEvent) {
+    this.db.prepare("INSERT INTO events (job_id, at, source, status, detail) VALUES (?, ?, ?, ?, ?)")
+      .run(e.jobId, e.at, e.source, e.status, e.detail);
+  }
+
+  events(jobId: string): JobEvent[] {
+    return (this.db.prepare("SELECT * FROM events WHERE job_id = ? ORDER BY rowid").all(jobId) as Row[]).map((r) => ({
+      jobId, at: r.at as number, source: r.source as JobEvent["source"], status: (r.status as JobStatus) ?? null,
+      detail: r.detail as string,
+    }));
+  }
+
+  /** Reputation stub: per-provider counts computed from the registry. */
+  reputation(provider: string) {
+    const r = this.db.prepare(`SELECT
+        COUNT(*) AS total,
+        SUM(verdict = 'pass') AS passed,
+        SUM(verdict = 'fail') AS failed,
+        SUM(status = 'paid') AS paid,
+        SUM(status = 'refunded') AS refunded,
+        SUM(status = 'expired_unclaimed') AS expiredUnclaimed
+      FROM jobs WHERE provider = ?`).get(provider) as Record<string, number | null>;
+    const n = (k: string) => r[k] ?? 0;
+    return {
+      provider, total: n("total"), passed: n("passed"), failed: n("failed"), paid: n("paid"),
+      refunded: n("refunded"), expiredUnclaimed: n("expiredUnclaimed"),
+    };
+  }
+}
diff --git a/src/registry/server.ts b/src/registry/server.ts
new file mode 100644
index 0000000..2547cf3
--- /dev/null
+++ b/src/registry/server.ts
@@ -0,0 +1,196 @@
+// Job registry HTTP API on 127.0.0.1:8801.
+//
+//   GET  /health
+//   POST /jobs                          create a draft job {client, provider, priceDrops, slaSeconds, spec}
+//   GET  /jobs[?status=&provider=&client=]
+//   GET  /jobs/:id
+//   PUT  /jobs/:id/condition            set by the oracle once, while the job is a draft
+//   POST /jobs/:id/deliverable          provider posts the work {content, auth}
+//   GET  /jobs/:id/deliverable
+//   POST /jobs/:id/events               status changes from the watcher (ledger) or the oracle
+//   GET  /jobs/:id/events
+//   GET  /providers/:address/reputation
+//
+// Job specs and deliverables are stored as data and never interpreted here.
+import { pathToFileURL } from "node:url";
+import { isValidClassicAddress } from "xrpl";
+import { checkRequest, sha256Hex } from "../auth.js";
+import { HttpError, jsonServer, listenLocal, type Route } from "../http.js";
+import { JOBS_DB, REGISTRY_PORT } from "../local-config.js";
+import { JobStore, TERMINAL, canMove, type CheckSpec, type Job, type JobPatch, type JobStatus, type NewJob } from "./db.js";
+
+const FORBIDDEN_KEYS = ["secret", "fulfillment", "preimage"];
+const CHECK_TYPES = ["sha256-match", "json-schema", "max-latency"];
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+
+function containsForbiddenKey(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(containsForbiddenKey);
+  if (!isObject(value)) return false;
+  return Object.keys(value).some((k) => FORBIDDEN_KEYS.includes(k.toLowerCase()) || containsForbiddenKey(value[k]));
+}
+
+function validCheck(c: unknown): c is CheckSpec {
+  if (!isObject(c) || !CHECK_TYPES.includes(c.type as string)) return false;
+  if (c.type === "sha256-match") return typeof c.sha256 === "string" && /^[0-9a-fA-F]{64}$/.test(c.sha256);
+  if (c.type === "json-schema") return isObject(c.schema);
+  return typeof c.maxMs === "number" && c.maxMs > 0;
+}
+
+export function parseNewJob(body: unknown): NewJob {
+  if (!isObject(body)) throw new HttpError(400, "body must be a JSON object");
+  if (containsForbiddenKey(body)) throw new HttpError(400, "the registry never stores secrets or fulfillments");
+  const { client, provider, priceDrops, slaSeconds, spec } = body;
+  if (typeof client !== "string" || !isValidClassicAddress(client)) throw new HttpError(400, "client must be an XRPL address");
+  if (typeof provider !== "string" || !isValidClassicAddress(provider)) throw new HttpError(400, "provider must be an XRPL address");
+  if (client === provider) throw new HttpError(400, "client and provider must differ");
+  if (typeof priceDrops !== "string" || !/^[1-9][0-9]{0,16}$/.test(priceDrops)) throw new HttpError(400, "priceDrops must be a positive drop string");
+  if (!Number.isInteger(slaSeconds) || (slaSeconds as number) < 30 || (slaSeconds as number) > 86_400) {
+    throw new HttpError(400, "slaSeconds must be an integer from 30 to 86400");
+  }
+  if (!isObject(spec) || !Array.isArray(spec.checks) || spec.checks.length === 0 || !spec.checks.every(validCheck)) {
+    throw new HttpError(400, `spec.checks must be a non-empty list of: ${CHECK_TYPES.join(", ")}`);
+  }
+  const title = typeof spec.title === "string" ? spec.title : undefined;
+  return { client, provider, priceDrops, slaSeconds: slaSeconds as number, spec: { title, checks: spec.checks } };
+}
+
+const LEDGER_STATUSES: JobStatus[] = ["funded", "paid", "refunded", "expired_unclaimed"];
+const ORACLE_STATUSES: JobStatus[] = ["verified_pass", "verified_fail"];
+
+export function registryRoutes(store: JobStore): Route[] {
+  const mustGet = (id: string): Job => {
+    const job = store.get(id);
+    if (!job) throw new HttpError(404, `unknown job ${id}`);
+    return job;
+  };
+
+  return [
+    { method: "GET", path: "/health", handler: () => ({ ok: true, service: "registry" }) },
+
+    { method: "POST", path: "/jobs", handler: (_p, body) => store.create(parseNewJob(body)) },
+
+    {
+      method: "GET", path: "/jobs",
+      handler: (_p, _b, q) => store.list({
+        status: q.get("status") ?? undefined, provider: q.get("provider") ?? undefined, client: q.get("client") ?? undefined,
+      }),
+    },
+
+    { method: "GET", path: "/jobs/:id", handler: ({ id }) => mustGet(id) },
+
+    {
+      method: "PUT", path: "/jobs/:id/condition",
+      handler: ({ id }, body) => {
+        const job = mustGet(id);
+        const condition = isObject(body) ? body.condition : undefined;
+        if (typeof condition !== "string" || !/^A0258020[0-9A-F]{64}810120$/.test(condition)) {
+          throw new HttpError(400, "condition must be an uppercase PREIMAGE-SHA-256 condition");
+        }
+        if (job.condition === condition) return job;
+        if (job.condition || job.status !== "draft") throw new HttpError(409, "condition is already set");
+        store.addEvent({ jobId: id, at: Date.now(), source: "oracle", status: null, detail: "condition set" });
+        return store.update(id, { condition });
+      },
+    },
+
+    {
+      method: "POST", path: "/jobs/:id/deliverable",
+      handler: ({ id }, body) => {
+        const job = mustGet(id);
+        if (!isObject(body) || typeof body.content !== "string") throw new HttpError(400, "content must be a string");
+        const sha256 = sha256Hex(body.content);
+        checkRequest(body.auth, "deliver", id, sha256, job.provider);
+        if (job.status !== "funded") throw new HttpError(409, `job is ${job.status}; deliverables are accepted only when funded`);
+        const deliveredAt = Date.now();
+        store.putDeliverable({ jobId: id, content: body.content, sha256, deliveredAt });
+        store.addEvent({ jobId: id, at: deliveredAt, source: "registry", status: "delivered", detail: `deliverable sha256 ${sha256}` });
+        return store.update(id, { status: "delivered", deliveredAt });
+      },
+    },
+
+    {
+      method: "GET", path: "/jobs/:id/deliverable",
+      handler: ({ id }) => {
+        mustGet(id);
+        const d = store.getDeliverable(id);
+        if (!d) throw new HttpError(404, "no deliverable yet");
+        return d;
+      },
+    },
+
+    { method: "POST", path: "/jobs/:id/events", handler: ({ id }, body) => applyEvent(store, mustGet(id), body) },
+
+    { method: "GET", path: "/jobs/:id/events", handler: ({ id }) => (mustGet(id), store.events(id)) },
+
+    {
+      method: "GET", path: "/providers/:address/reputation",
+      handler: ({ address }) => {
+        if (!isValidClassicAddress(address)) throw new HttpError(400, "not an XRPL address");
+        return store.reputation(address);
+      },
+    },
+  ];
+}
+
+/**
+ * Status changes reported by the watcher (source "ledger") or the oracle.
+ * The ledger is the source of truth for funded, paid and refunded: a
+ * validated EscrowFinish or EscrowCancel closes the job from any open state.
+ */
+function applyEvent(store: JobStore, job: Job, body: unknown): Job {
+  if (!isObject(body)) throw new HttpError(400, "body must be a JSON object");
+  const source = body.source;
+  if (source !== "ledger" && source !== "oracle") throw new HttpError(400, "source must be ledger or oracle");
+  const now = Date.now();
+  const str = (k: string) => (typeof body[k] === "string" ? (body[k] as string) : undefined);
+  const int = (k: string) => (Number.isInteger(body[k]) ? (body[k] as number) : undefined);
+
+  if (body.expiringSoon === true && source === "ledger" && !job.expiringSoon) {
+    store.addEvent({ jobId: job.id, at: now, source, status: null, detail: str("detail") ?? "escrow nears CancelAfter" });
+    job = store.update(job.id, { expiringSoon: true });
+  }
+
+  const status = body.status as JobStatus | undefined;
+  if (status === undefined) return job;
+  if (status === job.status) return job; // already applied
+  const allowed = source === "ledger" ? LEDGER_STATUSES : ORACLE_STATUSES;
+  if (!allowed.includes(status)) throw new HttpError(400, `${source} may not set status ${status}`);
+
+  const closes = status === "paid" || status === "refunded";
+  const anomaly = !canMove(job.status, status);
+  if (anomaly && !(source === "ledger" && closes && !TERMINAL.includes(job.status))) {
+    throw new HttpError(409, `cannot move job from ${job.status} to ${status}`);
+  }
+
+  const patch: JobPatch = { status };
+  if (status === "funded") Object.assign(patch, { offerSequence: int("offerSequence"), cancelAfter: int("cancelAfter"), createTx: str("txHash"), fundedAt: now });
+  if (status === "paid") Object.assign(patch, { finishTx: str("txHash"), closedAt: now });
+  if (status === "refunded") Object.assign(patch, { cancelTx: str("txHash"), closedAt: now });
+  if (status === "verified_pass" || status === "verified_fail") Object.assign(patch, { verdict: status === "verified_pass" ? "pass" : "fail", verifiedAt: now });
+
+  const detail = `${str("detail") ?? ""}${anomaly ? ` (ledger overrides ${job.status})` : ""}`.trim();
+  store.addEvent({ jobId: job.id, at: now, source, status, detail: detail || status });
+  return store.update(job.id, patch);
+}
+
+export async function startRegistry(opts: { dbPath?: string; port?: number } = {}) {
+  const store = new JobStore(opts.dbPath ?? JOBS_DB);
+  const server = jsonServer(registryRoutes(store));
+  const port = await listenLocal(server, opts.port ?? REGISTRY_PORT);
+  return {
+    port,
+    url: `http://127.0.0.1:${port}`,
+    store,
+    close: () => new Promise<void>((done) => {
+      server.close(() => (store.close(), done()));
+      server.closeAllConnections();
+    }),
+  };
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  startRegistry().then(({ url }) => console.log(`registry listening on ${url} (db ${JOBS_DB})`), (err) => {
+    console.error(err instanceof Error ? err.message : err);
+    process.exitCode = 1;
+  });
+}
diff --git a/src/sdk/index.ts b/src/sdk/index.ts
new file mode 100644
index 0000000..66847ac
--- /dev/null
+++ b/src/sdk/index.ts
@@ -0,0 +1,159 @@
+// TypeScript SDK for the local escrow kit. It wraps the registry and oracle
+// HTTP services and the ledger calls:
+//
+//   createJob()  register a draft job and get its condition from the oracle
+//   fundJob()    client locks the price in an EscrowCreate; resolves once the watcher marks it funded
+//   deliver()    provider posts the work and asks the oracle for a verdict (and, on a pass, the fulfillment)
+//   claim()      provider submits EscrowFinish with the fulfillment; resolves once the watcher marks it paid
+//   refund()     after CancelAfter, submits EscrowCancel; resolves once the watcher marks it refunded
+//
+// Every transaction is signed locally by the wallet that sends it.
+import type { Client, Wallet } from "xrpl";
+import { signRequest, sha256Hex, verifyPayload } from "../auth.js";
+import { cancelEscrow, createEscrow, finishEscrow, sleep, waitPastCancelAfter, type EscrowRef, type TxResult } from "../escrow.js";
+import { callJson } from "../http.js";
+import { ORACLE_URL, REGISTRY_URL } from "../local-config.js";
+import type { Job, JobEvent, JobSpec, JobStatus } from "../registry/db.js";
+import type { SignedVerdict, VerdictBody } from "../oracle/server.js";
+
+export type { Job, JobSpec, JobStatus } from "../registry/db.js";
+export type { SignedVerdict } from "../oracle/server.js";
+
+export interface KitOptions {
+  xrpl?: Client; // needed for fundJob, claim and refund
+  registryUrl?: string;
+  oracleUrl?: string;
+  /** How long to wait for the watcher to reflect a validated transaction. */
+  statusTimeoutMs?: number;
+}
+
+export interface NewJobInput {
+  client: string;
+  provider: string;
+  priceDrops: string;
+  slaSeconds: number;
+  spec: JobSpec;
+}
+
+export interface DeliverResult {
+  job: Job;
+  verdict: SignedVerdict;
+  verdictSignatureValid: boolean;
+  fulfillment: string | null;
+}
+
+/** Check a verdict's signature, and that it came from `oracleAddress` when given. */
+export function verifyVerdict(verdict: SignedVerdict, oracleAddress?: string): boolean {
+  const { signature, ...unsigned } = verdict;
+  if (oracleAddress && verdict.oracle !== oracleAddress) return false;
+  return verifyPayload(unsigned as VerdictBody, signature, verdict.publicKey, verdict.oracle);
+}
+
+export const escrowRef = (job: Job): EscrowRef => {
+  if (job.offerSequence === null || job.cancelAfter === null || job.condition === null) {
+    throw new Error(`job ${job.id} has no escrow on the ledger yet`);
+  }
+  return { owner: job.client, offerSequence: job.offerSequence, condition: job.condition, cancelAfter: job.cancelAfter };
+};
+
+export class EscrowKit {
+  readonly registryUrl: string;
+  readonly oracleUrl: string;
+  readonly #xrpl?: Client;
+  readonly #timeout: number;
+
+  constructor(opts: KitOptions = {}) {
+    this.registryUrl = opts.registryUrl ?? REGISTRY_URL;
+    this.oracleUrl = opts.oracleUrl ?? ORACLE_URL;
+    this.#xrpl = opts.xrpl;
+    this.#timeout = opts.statusTimeoutMs ?? 60_000;
+  }
+
+  #ledger(): Client {
+    if (!this.#xrpl) throw new Error("this call needs an xrpl Client: new EscrowKit({ xrpl })");
+    return this.#xrpl;
+  }
+
+  getJob(jobId: string): Promise<Job> {
+    return callJson<Job>("GET", `${this.registryUrl}/jobs/${encodeURIComponent(jobId)}`);
+  }
+
+  events(jobId: string): Promise<JobEvent[]> {
+    return callJson<JobEvent[]>("GET", `${this.registryUrl}/jobs/${encodeURIComponent(jobId)}/events`);
+  }
+
+  reputation(provider: string) {
+    return callJson<{ provider: string; total: number; passed: number; failed: number; paid: number; refunded: number; expiredUnclaimed: number }>(
+      "GET", `${this.registryUrl}/providers/${provider}/reputation`);
+  }
+
+  oracleInfo(): Promise<{ oracle: string; publicKey: string }> {
+    return callJson("GET", `${this.oracleUrl}/health`);
+  }
+
+  /** Poll the registry until the job reaches one of `statuses`. */
+  async waitForStatus(jobId: string, statuses: JobStatus[], timeoutMs = this.#timeout): Promise<Job> {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const job = await this.getJob(jobId);
+      if (statuses.includes(job.status)) return job;
+      if (Date.now() > deadline) throw new Error(`job ${jobId} is ${job.status}, still waiting for ${statuses.join(" or ")}`);
+      await sleep(500);
+    }
+  }
+
+  /** Register a draft job, then have the oracle create its secret and set the condition. */
+  async createJob(input: NewJobInput): Promise<Job> {
+    const draft = await callJson<Job>("POST", `${this.registryUrl}/jobs`, input);
+    await callJson("POST", `${this.oracleUrl}/jobs/${draft.id}/condition`);
+    return this.getJob(draft.id);
+  }
+
+  /** Client locks the price in escrow. Resolves when the watcher has seen the validated EscrowCreate. */
+  async fundJob(jobId: string, clientWallet: Wallet): Promise<{ tx: TxResult; job: Job }> {
+    const job = await this.getJob(jobId);
+    if (job.status !== "draft" || !job.condition) throw new Error(`job ${jobId} is ${job.status}; only a draft with a condition can be funded`);
+    if (clientWallet.address !== job.client) throw new Error("only the job's client can fund it");
+    const tx = await createEscrow(this.#ledger(), clientWallet, job.provider, job.priceDrops, job.condition, job.slaSeconds);
+    if (tx.code !== "tesSUCCESS") return { tx, job };
+    return { tx, job: await this.waitForStatus(jobId, ["funded"]) };
+  }
+
+  /** Ask the oracle to verify the delivered work. Signed by `wallet`; only the job's provider gets an answer. */
+  async requestVerification(jobId: string, wallet: Wallet): Promise<{ verdict: SignedVerdict; fulfillment?: string }> {
+    return callJson("POST", `${this.oracleUrl}/verify/${jobId}`, { auth: signRequest(wallet, "verify", jobId) });
+  }
+
+  /** Provider posts the work, then asks the oracle to verify it. */
+  async deliver(jobId: string, providerWallet: Wallet, content: string): Promise<DeliverResult> {
+    await callJson("POST", `${this.registryUrl}/jobs/${jobId}/deliverable`, {
+      content, auth: signRequest(providerWallet, "deliver", jobId, sha256Hex(content)),
+    });
+    const { verdict, fulfillment } = await this.requestVerification(jobId, providerWallet);
+    const { oracle } = await this.oracleInfo();
+    return {
+      job: await this.getJob(jobId),
+      verdict,
+      verdictSignatureValid: verifyVerdict(verdict, oracle) && verdict.evidenceHash === sha256Hex(content),
+      fulfillment: fulfillment ?? null,
+    };
+  }
+
+  /** Provider finishes the escrow with the oracle's fulfillment. Resolves when the watcher marks the job paid. */
+  async claim(jobId: string, providerWallet: Wallet, fulfillment: string): Promise<{ tx: TxResult; job: Job }> {
+    const job = await this.getJob(jobId);
+    const tx = await finishEscrow(this.#ledger(), providerWallet, escrowRef(job), fulfillment);
+    if (tx.code !== "tesSUCCESS") return { tx, job: await this.getJob(jobId) };
+    return { tx, job: await this.waitForStatus(jobId, ["paid"]) };
+  }
+
+  /** Waits for a validated ledger past CancelAfter, then cancels. Resolves when the watcher marks the job refunded. */
+  async refund(jobId: string, wallet: Wallet): Promise<{ tx: TxResult; job: Job }> {
+    const job = await this.getJob(jobId);
+    const ref = escrowRef(job);
+    await waitPastCancelAfter(this.#ledger(), ref);
+    const tx = await cancelEscrow(this.#ledger(), wallet, ref);
+    if (tx.code !== "tesSUCCESS") return { tx, job: await this.getJob(jobId) };
+    return { tx, job: await this.waitForStatus(jobId, ["refunded"]) };
+  }
+}
